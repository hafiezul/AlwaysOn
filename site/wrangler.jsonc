{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alwayson",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Static files come from dist/, which `npm run build` assembles. The Worker's
  // own routes are listed in run_worker_first, because a browser that
  // navigates to a path with no matching file gets the 404 page straight from
  // the assets, without the Worker ever running.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download", "/download/*", "/latest.json", "/e"]
  },
  // Where the page's anonymous visit counts go. It's the same PostHog project
  // as the app's opt-in statistics; a project token can only write events, so
  // it's safe to keep here. Remove POSTHOG_KEY to turn the counts off.
  "vars": {
    "POSTHOG_KEY": "phc_m9GxX4qyh25oA538LiKpS7RM97mVRbpd28dQPTWEJnAB",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "workers_dev": false,
  // Cloudflare creates the DNS record and certificate for this hostname
  "routes": [{ "pattern": "alwayson.hafiezulzikry.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
